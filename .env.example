# Discord bot
DISCORD_TOKEN=replace_with_your_bot_token
CLIENT_ID=replace_with_your_application_id
GUILD_ID=replace_with_your_test_guild_id
DATABASE_URL="mysql://user:password@127.0.0.1:3306/sarabot_db"

# Web dashboard OAuth (Discord Developer Portal > OAuth2)
DISCORD_CLIENT_ID=replace_with_your_application_id
DISCORD_CLIENT_SECRET=replace_with_your_oauth_client_secret
DASHBOARD_URL=https://panel.example.com
DASHBOARD_PORT=3000
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret
